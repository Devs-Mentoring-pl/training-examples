# Skopiuj do .env i uzupełnij. NIE commituj pliku .env!

SNOWFLAKE_ACCOUNT=abcdefg-xy12345
SNOWFLAKE_USER=twoj_uzytkownik
SNOWFLAKE_WAREHOUSE=LEARN_WH
SNOWFLAKE_DATABASE=SHOP_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_QUERY_TAG=training-examples

# Uwierzytelnianie – wybierz JEDNĄ opcję:
# 1) klucz RSA (zalecane dla skryptów i CI/CD)
# SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/snowflake_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# 2) hasło (tylko konto osobowe, wymaga MFA)
# SNOWFLAKE_PASSWORD=

# 3) brak obu -> logowanie przez przeglądarkę (externalbrowser)
